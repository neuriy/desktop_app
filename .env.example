# Neuriy desktop — copy to .env.local and override as needed.
# Defaults match the IDHook (nID) Firebase project so accounts are shared.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Hosted Neuriy ID login web app (IDHook)
VITE_NID_LOGIN_URL=https://id.neuriy.com

# ElloFive AI — https://github.com/EricksonAtHome/ElloFive
# Local: ellofive serve && ellofive api  →  http://127.0.0.1:3000
# Cloud: https://api.ello5.com
VITE_ELLOFIVE_API_URL=http://127.0.0.1:3000
VITE_ELLOFIVE_MODEL=ellofive
