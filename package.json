{
  "name": "neuriy",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173\" \"npm run electron:compile && npm run electron:start\"",
    "dev:web": "vite --port 5173",
    "demo:capture": "node scripts/capture-auth-demo.mjs",
    "icons": "node scripts/generate-icons.js",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:start": "wait-on http://localhost:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run icons && vite build && tsc -p tsconfig.electron.json && electron-builder",
    "build:dir": "npm run icons && vite build && tsc -p tsconfig.electron.json && electron-builder --dir",
    "build:mac": "npm run icons && vite build && tsc -p tsconfig.electron.json && electron-builder --mac",
    "build:win": "npm run icons && vite build && tsc -p tsconfig.electron.json && electron-builder --win",
    "build:linux": "npm run icons && vite build && tsc -p tsconfig.electron.json && electron-builder --linux",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neuriy/auth": "file:vendor/neuriy-auth",
    "@react-three/drei": "^9.105.4",
    "@react-three/fiber": "^8.16.2",
    "@react-three/postprocessing": "^2.16.0",
    "framer-motion": "^11.1.7",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.164.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.164.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "playwright": "^1.62.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.neuriy.app",
    "productName": "Neuriy",
    "copyright": "Copyright © Neuriy",
    "directories": {
      "output": "release/${version}",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-Mac-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSUserNotificationAlertStyle": "alert"
      }
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "assets/icons/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Windows-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Neuriy"
    },
    "linux": {
      "icon": "assets/icons",
      "category": "Utility",
      "synopsis": "Neuriy AI assistant — native system tray app",
      "desktop": {
        "StartupWMClass": "Neuriy",
        "Categories": "Utility;Network;"
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Linux-${version}-${arch}.${ext}"
    }
  }
}
